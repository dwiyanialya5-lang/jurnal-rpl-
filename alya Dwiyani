<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Jurnal harian Praktik Kerja Lapangan (PKL) jurusan RPL SMKN 2 Cipatujah.">
<title>Jurnal PKL RPL - SMKN 2 Cipatujah</title>
<style>
:root{--bg:#f3f6fb;--sf:#fff;--tx:#1b2433;--mu:#5d6b82;--ln:#dfe6f0;--pr:#1f5fd6;--pd:#1748a8;--ps:#e8f0fe;--dg:#c62828;--ds:#fdecec;--ok:#1b7f3b;--wn:#b26a00;--ws:#fff4e0;--r:14px;--sh:0 2px 10px rgba(20,40,80,.07)}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;background:var(--bg);color:var(--tx);line-height:1.5;font-size:16px}
h1,h2,h3{line-height:1.25;margin:0}
button,input,textarea{font:inherit;color:inherit}
.wrap{max-width:1100px;margin:0 auto;padding:0 14px}
.hero{background:linear-gradient(135deg,#1748a8,#1f5fd6 60%,#3a86ff);color:#fff;padding:22px 0 64px}
.top{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-start;justify-content:space-between}
.eyebrow{font-size:.85rem;opacity:.85}
.hero h1{font-size:1.6rem;margin-top:4px}
.sub{opacity:.9;font-size:.95rem}
.btn{display:inline-flex;align-items:center;justify-content:center;border:1px solid transparent;border-radius:10px;padding:10px 16px;font-weight:600;cursor:pointer;min-height:44px;background:var(--pr);color:#fff}
.btn:hover{background:var(--pd)}
.btn:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #8db4ff;outline-offset:2px}
.btn.sec{background:var(--sf);color:var(--pr);border-color:var(--ln)}
.btn.sec:hover{background:var(--ps)}
.btn.ghost{background:rgba(255,255,255,.16);color:#fff;border-color:rgba(255,255,255,.4)}
.btn.ghost:hover{background:rgba(255,255,255,.28)}
.btn.dg{background:var(--dg)}
.btn.dg:hover{background:#9f1d1d}
.btn.dgo{background:var(--sf);color:var(--dg);border-color:#f0c5c5}
.btn.dgo:hover{background:var(--ds)}
.btn.sm{min-height:38px;padding:6px 12px;font-size:.9rem}
.acts{display:flex;flex-wrap:wrap;gap:8px}
.identity{margin-top:-44px;background:var(--sf);border-radius:var(--r);box-shadow:var(--sh);padding:16px;border:1px solid var(--ln)}
.identity h2{font-size:1rem;color:var(--mu);margin-bottom:10px}
dl.idgrid{margin:0;display:grid;grid-template-columns:1fr;gap:10px}
.idgrid div{background:var(--bg);border-radius:10px;padding:10px 12px}
.idgrid dt{font-size:.8rem;color:var(--mu)}
.idgrid dd{margin:2px 0 0;font-weight:600;word-break:break-word}
main{padding:18px 0 40px;display:grid;gap:18px}
.card{background:var(--sf);border-radius:var(--r);box-shadow:var(--sh);border:1px solid var(--ln);padding:16px}
.card h2{font-size:1.15rem;margin-bottom:12px}
.field{display:flex;flex-direction:column;gap:5px;margin-bottom:12px}
.field label{font-weight:600;font-size:.92rem}
.req{color:var(--dg)}
.hint{font-size:.8rem;color:var(--mu)}
input[type=text],input[type=date],input[type=time],input[type=search],textarea{width:100%;padding:10px 12px;border:1px solid #c9d3e2;border-radius:10px;background:#fff;min-height:44px}
textarea{min-height:92px;resize:vertical}
.invalid{border-color:var(--dg)!important;background:var(--ds)!important}
.err{color:var(--dg);font-size:.82rem;display:none}
.err.show{display:block}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.banner{background:var(--ws);color:var(--wn);border:1px solid #f1d49c;border-radius:10px;padding:8px 12px;margin-bottom:12px;font-size:.9rem;display:none}
.banner.show{display:block}
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.stat{background:var(--ps);border-radius:12px;padding:12px}
.stat b{display:block;font-size:1.6rem;color:var(--pd);line-height:1.1}
.stat span{font-size:.82rem;color:var(--mu)}
.filters{display:grid;gap:10px;grid-template-columns:1fr}
.filters .field{margin:0}
.lhead{display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between;margin-bottom:10px}
.entries{display:grid;gap:12px}
.entry{border:1px solid var(--ln);border-left:5px solid var(--pr);border-radius:12px;padding:14px;background:#fff}
.meta{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:8px}
.badge{font-size:.78rem;padding:2px 9px;border-radius:999px;background:var(--ps);color:var(--pd);font-weight:600}
.badge.sample{background:var(--ws);color:var(--wn)}
.entry h3{font-size:1rem;white-space:pre-wrap;word-break:break-word}
.lbl{font-size:.82rem;color:var(--mu);margin-top:8px;font-weight:600}
.entry p{margin:2px 0 0;white-space:pre-wrap;word-break:break-word}
.entry .acts{margin-top:12px}
.empty{text-align:center;padding:30px 12px;color:var(--mu);border:2px dashed var(--ln);border-radius:12px}
.empty h3{color:var(--tx);margin-bottom:4px}
#toasts{position:fixed;left:12px;right:12px;bottom:14px;display:grid;gap:8px;z-index:60;pointer-events:none;max-width:460px;margin:0 auto}
.toast{padding:12px 14px;border-radius:10px;font-weight:600;box-shadow:0 6px 20px rgba(0,0,0,.18);color:#fff}
.toast.ok{background:var(--ok)}.toast.fail{background:var(--dg)}.toast.info{background:#2b3a55}
.overlay{position:fixed;inset:0;background:rgba(15,25,45,.55);display:none;align-items:flex-end;justify-content:center;z-index:50}
.overlay.show{display:flex}
.modal{background:#fff;width:100%;max-width:560px;border-radius:18px 18px 0 0;padding:18px;max-height:92vh;overflow:auto}
.modal h2{font-size:1.15rem;margin-bottom:8px}
.modal p{margin:4px 0 14px;color:var(--mu)}
.modal .acts{justify-content:flex-end}
footer{color:var(--mu);font-size:.82rem;text-align:center;padding:0 14px 28px}
.print-only{display:none}
@media(min-width:640px){
dl.idgrid{grid-template-columns:repeat(2,1fr)}
.filters{grid-template-columns:2fr 1fr 1fr}
.stats{grid-template-columns:repeat(4,1fr)}
.overlay{align-items:center;padding:16px}
.modal{border-radius:18px}
.hero h1{font-size:2rem}}
@media(min-width:960px){
dl.idgrid{grid-template-columns:repeat(3,1fr)}
main{grid-template-columns:380px 1fr;align-items:start}
.col-left{position:sticky;top:12px;display:grid;gap:18px}
.col-right{display:grid;gap:18px}}
@page{size:A4;margin:14mm}
@media print{
body{background:#fff;color:#000;font-size:11pt}
.no-print,#toasts,.overlay{display:none!important}
.print-only{display:block!important}
main{display:block!important;padding:0}
.card{box-shadow:none;border:none;padding:0}
.p-title{text-align:center;margin-bottom:10px}
.p-title h1{font-size:15pt}
.p-title p{margin:0;font-size:10pt}
table.p-id{width:100%;border-collapse:collapse;margin:8px 0 12px;font-size:10pt}
table.p-id td{padding:2px 4px;vertical-align:top}
table.p-id td:first-child{width:130px;font-weight:600}
table.p-table{width:100%;border-collapse:collapse;font-size:9.5pt}
table.p-table th,table.p-table td{border:1px solid #000;padding:4px 6px;vertical-align:top;text-align:left;white-space:pre-wrap;word-break:break-word}
table.p-table th{background:#e6e6e6;-webkit-print-color-adjust:exact;print-color-adjust:exact}
table.p-table tr{page-break-inside:avoid}
thead{display:table-header-group}
.p-note{font-size:9pt;margin-top:8px}
.p-sign{display:flex;justify-content:space-between;margin-top:28px;page-break-inside:avoid;font-size:10pt}
.p-sign>div{width:45%;text-align:center}
.p-sign .line{margin-top:60px;border-top:1px solid #000;padding-top:2px}}
</style>
</head>
<body>

<header class="hero no-print">
  <div class="wrap">
    <div class="top">
      <div>
        <div class="eyebrow">SMKN 2 Cipatujah, Program Keahlian RPL</div>
        <h1>Jurnal PKL RPL</h1>
        <div class="sub">Catat kegiatan harian Praktik Kerja Lapangan dengan rapi.</div>
      </div>
      <div class="acts">
        <button type="button" class="btn ghost" id="btnEditProfile">Edit Identitas</button>
        <button type="button" class="btn ghost" id="btnPrintTop">Cetak Jurnal</button>
      </div>
    </div>
  </div>
</header>

<div class="wrap no-print">
  <section class="identity" aria-labelledby="idTitle">
    <h2 id="idTitle">Identitas Siswa PKL</h2>
    <dl class="idgrid">
      <div><dt>Nama Siswa</dt><dd id="vNama">-</dd></div>
      <div><dt>Kelas</dt><dd id="vKelas">-</dd></div>
      <div><dt>Tempat PKL</dt><dd id="vTempat">-</dd></div>
      <div><dt>Pembimbing</dt><dd id="vPembimbing">-</dd></div>
      <div><dt>Periode PKL</dt><dd id="vPeriode">-</dd></div>
    </dl>
  </section>
</div>

<div class="wrap">
<main>
  <div class="col-left no-print">
    <section class="card" aria-labelledby="formTitle">
      <h2 id="formTitle">Tambah Jurnal</h2>
      <div class="banner" id="editBanner" role="status">Mode edit: kamu sedang mengubah jurnal yang sudah ada.</div>
      <form id="entryForm" novalidate>
        <div class="field">
          <label for="fTanggal">Tanggal <span class="req">*</span></label>
          <input type="date" id="fTanggal">
          <div class="err" id="eTanggal"></div>
        </div>
        <div class="row2">
          <div class="field">
            <label for="fMulai">Jam Mulai <span class="req">*</span></label>
            <input type="time" id="fMulai">
            <div class="err" id="eMulai"></div>
          </div>
          <div class="field">
            <label for="fSelesai">Jam Selesai <span class="req">*</span></label>
            <input type="time" id="fSelesai">
            <div class="err" id="eSelesai"></div>
          </div>
        </div>
        <div class="field">
          <label for="fKegiatan">Kegiatan / Pekerjaan <span class="req">*</span></label>
          <textarea id="fKegiatan" maxlength="1000" placeholder="Contoh: Membuat halaman login dengan HTML dan CSS"></textarea>
          <div class="err" id="eKegiatan"></div>
        </div>
        <div class="field">
          <label for="fHasil">Hasil / Kompetensi yang Dipelajari <span class="req">*</span></label>
          <textarea id="fHasil" maxlength="1000" placeholder="Contoh: Memahami struktur form dan validasi dasar"></textarea>
          <div class="err" id="eHasil"></div>
        </div>
        <div class="field">
          <label for="fKendala">Kendala</label>
          <textarea id="fKendala" maxlength="1000" placeholder="Kosongkan jika tidak ada kendala"></textarea>
          <span class="hint">Opsional.</span>
        </div>
        <div class="field">
          <label for="fRencana">Rencana Tindak Lanjut</label>
          <textarea id="fRencana" maxlength="1000" placeholder="Contoh: Mempelajari fetch API untuk besok"></textarea>
          <span class="hint">Opsional.</span>
        </div>
        <div class="acts">
          <button type="submit" class="btn" id="btnSubmit">Simpan Jurnal</button>
          <button type="button" class="btn sec" id="btnCancelEdit" style="display:none">Batal Edit</button>
          <button type="button" class="btn sec" id="btnResetForm">Kosongkan Form</button>
        </div>
      </form>
    </section>

    <section class="card" aria-labelledby="recapTitle">
      <h2 id="recapTitle">Rekap Jurnal</h2>
      <div class="stats">
        <div class="stat"><b id="sTotal">0</b><span>Total jurnal</span></div>
        <div class="stat"><b id="sShown">0</b><span>Sedang ditampilkan</span></div>
        <div class="stat"><b id="sDays">0</b><span>Hari tercatat</span></div>
        <div class="stat"><b id="sHours">0</b><span>Total jam (tampil)</span></div>
      </div>
    </section>
  </div>

  <div class="col-right">
    <section class="card no-print" aria-labelledby="filterTitle">
      <h2 id="filterTitle">Cari dan Filter</h2>
      <div class="filters">
        <div class="field"><label for="qSearch">Cari kata kunci</label><input type="search" id="qSearch" placeholder="Cari kegiatan, hasil, kendala..."></div>
        <div class="field"><label for="qFrom">Dari tanggal</label><input type="date" id="qFrom"></div>
        <div class="field"><label for="qTo">Sampai tanggal</label><input type="date" id="qTo"></div>
      </div>
      <div class="err" id="eFilter" style="margin-top:6px"></div>
      <div class="acts" style="margin-top:8px"><button type="button" class="btn sec sm" id="btnResetFilter">Reset Filter</button></div>
    </section>

    <section class="card" aria-labelledby="listTitle">
      <div class="lhead no-print">
        <h2 id="listTitle" style="margin:0">Daftar Jurnal</h2>
        <div class="acts">
          <button type="button" class="btn sm" id="btnPrint">Cetak</button>
          <button type="button" class="btn sec sm" id="btnExport">Ekspor Cadangan</button>
          <button type="button" class="btn sec sm" id="btnImport">Impor Cadangan</button>
          <input type="file" id="fileImport" accept="application/json,.json" hidden>
        </div>
      </div>
      <div class="acts no-print" style="margin-bottom:12px">
        <button type="button" class="btn dgo sm" id="btnDelSample" style="display:none">Hapus Data Contoh</button>
        <button type="button" class="btn dgo sm" id="btnDelAll">Hapus Semua Data</button>
      </div>

      <div id="entries" class="entries no-print" aria-live="polite"></div>

      <div class="print-only" id="printArea">
        <div class="p-title">
          <h1>JURNAL PRAKTIK KERJA LAPANGAN (PKL)</h1>
          <p>Program Keahlian Rekayasa Perangkat Lunak (RPL) - SMKN 2 Cipatujah</p>
        </div>
        <table class="p-id">
          <tr><td>Nama Siswa</td><td>: <span id="pNama"></span></td></tr>
          <tr><td>Kelas</td><td>: <span id="pKelas"></span></td></tr>
          <tr><td>Tempat PKL</td><td>: <span id="pTempat"></span></td></tr>
          <tr><td>Pembimbing</td><td>: <span id="pPembimbing"></span></td></tr>
          <tr><td>Periode PKL</td><td>: <span id="pPeriode"></span></td></tr>
        </table>
        <table class="p-table">
          <thead><tr><th style="width:26px">No</th><th style="width:80px">Tanggal</th><th style="width:62px">Jam</th><th>Kegiatan</th><th>Hasil / Kompetensi</th><th>Kendala</th><th>Rencana Tindak Lanjut</th></tr></thead>
          <tbody id="pBody"></tbody>
        </table>
        <div class="p-note" id="pNote"></div>
        <div class="p-sign">
          <div>Pembimbing<div class="line" id="pSignPemb"></div></div>
          <div>Siswa<div class="line" id="pSignSiswa"></div></div>
        </div>
      </div>
    </section>
  </div>
</main>
</div>

<footer class="no-print">Data tersimpan di browser perangkat ini (localStorage). Gunakan Ekspor Cadangan secara berkala.</footer>

<div id="toasts" role="status" aria-live="polite"></div>

<div class="overlay" id="modalProfile" role="dialog" aria-modal="true" aria-labelledby="mpTitle">
  <div class="modal">
    <h2 id="mpTitle">Edit Identitas Siswa</h2>
    <form id="profileForm" novalidate>
      <div class="field"><label for="pfNama">Nama Siswa <span class="req">*</span></label><input type="text" id="pfNama" maxlength="80"><div class="err" id="epNama"></div></div>
      <div class="field"><label for="pfKelas">Kelas <span class="req">*</span></label><input type="text" id="pfKelas" maxlength="40" placeholder="Contoh: XI RPL 1"><div class="err" id="epKelas"></div></div>
      <div class="field"><label for="pfTempat">Tempat PKL <span class="req">*</span></label><input type="text" id="pfTempat" maxlength="100"><div class="err" id="epTempat"></div></div>
      <div class="field"><label for="pfPembimbing">Pembimbing <span class="req">*</span></label><input type="text" id="pfPembimbing" maxlength="100"><div class="err" id="epPembimbing"></div></div>
      <div class="row2">
        <div class="field"><label for="pfMulai">Periode Mulai <span class="req">*</span></label><input type="date" id="pfMulai"><div class="err" id="epMulai"></div></div>
        <div class="field"><label for="pfSelesai">Periode Selesai <span class="req">*</span></label><input type="date" id="pfSelesai"><div class="err" id="epSelesai"></div></div>
      </div>
      <div class="acts">
        <button type="button" class="btn sec" id="btnProfileCancel">Batal</button>
        <button type="submit" class="btn">Simpan Identitas</button>
      </div>
    </form>
  </div>
</div>

<div class="overlay" id="modalConfirm" role="alertdialog" aria-modal="true" aria-labelledby="mcTitle" aria-describedby="mcText">
  <div class="modal">
    <h2 id="mcTitle">Konfirmasi</h2>
    <p id="mcText"></p>
    <div class="acts">
      <button type="button" class="btn sec" id="btnConfirmNo">Batal</button>
      <button type="button" class="btn dg" id="btnConfirmYes">Ya, Hapus</button>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';
  var K_E = 'jurnalPklRpl.v1.entries', K_P = 'jurnalPklRpl.v1.profile', K_I = 'jurnalPklRpl.v1.initialized';
  var entries = [], profile = null, editingId = null, confirmFn = null, lastFocus = null;
  var MON = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];

  function $(id) { return document.getElementById(id); }
  function h(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined && text !== null) e.textContent = text;
    return e;
  }
  function rd(k, fb) {
    try { var r = localStorage.getItem(k); return r === null ? fb : JSON.parse(r); } catch (e) { return fb; }
  }
  function wr(k, v) {
    try { localStorage.setItem(k, JSON.stringify(v)); return true; } catch (e) { return false; }
  }
  function save() {
    var ok = wr(K_E, entries);
    if (!ok) toast('fail', 'Gagal menyimpan ke browser. Penyimpanan penuh atau dinonaktifkan (mode privat). Data hanya ada sampai halaman ditutup, jadi segera ekspor cadangan.');
    return ok;
  }
  function newId() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 8); }
  function today() {
    var d = new Date(), m = d.getMonth() + 1, day = d.getDate();
    return d.getFullYear() + '-' + (m < 10 ? '0' : '') + m + '-' + (day < 10 ? '0' : '') + day;
  }
  function fmtDate(s) {
    var p = String(s || '').split('-');
    if (p.length !== 3) return s || '-';
    return parseInt(p[2], 10) + ' ' + MON[parseInt(p[1], 10) - 1] + ' ' + p[0];
  }
  function mins(t) { var p = String(t).split(':'); return parseInt(p[0], 10) * 60 + parseInt(p[1], 10); }
  function str(v, max) { return (typeof v === 'string' ? v : '').trim().slice(0, max || 1000); }

  /* ---------- Toast & modal ---------- */
  function toast(type, msg) {
    var t = h('div', 'toast ' + type, msg);
    $('toasts').appendChild(t);
    setTimeout(function () { if (t.parentNode) t.parentNode.removeChild(t); }, type === 'fail' ? 6000 : 3200);
  }
  function openModal(id, focusId) {
    lastFocus = document.activeElement;
    $(id).classList.add('show');
    var f = $(focusId); if (f) f.focus();
  }
  function closeModal(id) {
    $(id).classList.remove('show');
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }
  function ask(title, text, yesLabel, fn) {
    $('mcTitle').textContent = title;
    $('mcText').textContent = text;
    $('btnConfirmYes').textContent = yesLabel || 'Ya, Hapus';
    $('btnConfirmYes').className = 'btn dg';
    confirmFn = fn;
    openModal('modalConfirm', 'btnConfirmNo');
  }

  /* ---------- Validasi ---------- */
  function setErr(id, msg, fieldId) {
    var e = $(id), f = $(fieldId);
    e.textContent = msg || '';
    e.classList.toggle('show', !!msg);
    if (f) f.classList.toggle('invalid', !!msg);
    return !!msg;
  }

  /* ---------- Data awal ---------- */
  function sampleProfile() {
    return { nama: 'Budi Santoso (contoh)', kelas: 'XI RPL 1', tempat: 'PT Nusantara Digital (contoh)',
      pembimbing: 'Ibu Sari Wulandari (contoh)', mulai: '2026-07-06', selesai: '2026-12-18' };
  }
  function sampleEntries() {
    function e(t, m, s, k, hs, kd, r) {
      return { id: newId(), sample: true, tanggal: t, mulai: m, selesai: s, kegiatan: k, hasil: hs, kendala: kd, rencana: r };
    }
    return [
      e('2026-07-06', '08:00', '15:00', 'Orientasi perusahaan dan pengenalan alur kerja tim pengembang.', 'Mengenal struktur tim, aturan keselamatan kerja, dan tools yang dipakai (Git, VS Code).', '', 'Menyiapkan lingkungan kerja dan akun repositori.'),
